<?xml version="1.0" encoding="utf-8"?>
<!--
    INTENDRA adaptive icon foreground.
    The artwork is centered inside the 72dp safe zone of the 108dp
    adaptive-icon viewport, leaving the outer area available for launcher
    masks and parallax without creating a white border.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Small accent nodes echo the INTENDRA network/agent identity. -->
    <path
        android:fillColor="#58A6FF"
        android:pathData="M22,31 A5,5 0,1 0,32,31 A5,5 0,1 0,22,31" />
    <path
        android:fillColor="#A371F7"
        android:pathData="M76,77 A5,5 0,1 0,86,77 A5,5 0,1 0,76,77" />

    <!-- Bold central I remains legible at small launcher sizes. -->
    <path
        android:fillColor="#E6EDF3"
        android:pathData="M39,25 L69,25 L69,34 L60,34 L60,74 L69,74 L69,83 L39,83 L39,74 L48,74 L48,34 L39,34 Z" />

    <!-- Blue/magenta signal bars add contrast without reaching the mask edge. -->
    <path
        android:fillColor="#58A6FF"
        android:pathData="M24,43 L31,43 L31,65 L24,65 Z" />
    <path
        android:fillColor="#A371F7"
        android:pathData="M77,43 L84,43 L84,65 L77,65 Z" />
</vector>
